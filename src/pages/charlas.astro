---
import Layout from "../layouts/Layout.astro";
import TalkItem from "../components/TalkItem.astro";
import TalksMap from "../components/TalksMap.astro";
import { sortedTalks, impact, kindLabel, type TalkKind } from "../data/talks";

const byYear = new Map<string, typeof sortedTalks>();
for (const t of sortedTalks) {
  const y = t.date.slice(0, 4);
  byYear.set(y, [...(byYear.get(y) ?? []), t]);
}
const kinds = Object.keys(kindLabel) as TalkKind[];
---

<Layout
  image="/og/charlas.png"
  imageAlt="Charlas y recursos de Vanessa Marely: mapa de las ciudades donde ha dado charlas presenciales"
  title="Charlas · Vanessa Marely"
  description="Charlas, talleres, paneles y mentorías de Vanessa Marely sobre Angular, rendimiento web, DevTools, accesibilidad e IA, con slides, videos y enlaces a cada evento."
>
  <section class="page">
    <div class="wrap">
      <header class="head">
        <span class="eyebrow">Speaker</span>
        <h1>Charlas &amp; <em class="serif">recursos</em></h1>
        <p class="muted">
          {sortedTalks.length} charlas, talleres, paneles, mentorías y transmisiones en vivo desde 2018, con sus slides,
          videos, repositorios y demos cuando existen.
        </p>
        <ul class="impact">
          {impact.map((s) => <li><strong>{s.value}+</strong> {s.label} <small>· {s.detail}</small></li>)}
        </ul>
      </header>

      <div class="map">
        <TalksMap />
      </div>

      <div class="filters" role="group" aria-label="Filtrar charlas">
        <button type="button" data-kind="all" aria-pressed="true">Todo</button>
        {kinds.map((k) => <button type="button" data-kind={k} aria-pressed="false">{kindLabel[k]}</button>)}
        <label class="toggle">
          <input type="checkbox" id="onlyRes" />
          <span>Solo con slides / video</span>
        </label>
      </div>

      <div class="timeline">
        {
          [...byYear].map(([year, items]) => (
            <section class="year reveal" data-year={year}>
              <h2>
                <span>{year}</span>
                <small>{items.length}</small>
              </h2>
              <ul>
                {items.map((t) => (
                  <TalkItem talk={t} />
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    padding: 150px 0 100px;
  }
  .head {
    max-width: 780px;
    margin-bottom: 40px;
  }
  .head h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    margin: 14px 0 18px;
    letter-spacing: -0.05em;
  }
  .head em {
    color: var(--coral);
  }
  .muted {
    color: var(--muted);
    font-size: 1.15rem;
  }
  .impact {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .impact li {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .impact small {
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .map {
    margin-bottom: 40px;
  }

  .filters {
    position: sticky;
    top: 80px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px;
    margin-bottom: 32px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .filters button {
    font: 500 0.9rem var(--font-sans);
    border: 0;
    background: transparent;
    color: var(--ink);
    padding: 8px 14px;
    border-radius: 999px;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--bg);
  }
  .toggle {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .toggle input {
    accent-color: var(--violet);
    width: 18px;
    height: 18px;
  }

  .year {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding-bottom: 40px;
  }
  .year[hidden] {
    display: none;
  }
  .year h2 {
    position: sticky;
    top: 160px;
    align-self: start;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    letter-spacing: -0.05em;
    display: flex;
    align-items: start;
    gap: 6px;
  }
  .year h2 small {
    font: 500 0.8rem var(--font-mono);
    color: var(--muted);
    margin-top: 8px;
  }
  .year ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }

  @media (max-width: 720px) {
    .year {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .year h2 {
      position: static;
    }
    .filters {
      top: 72px;
    }
    .toggle {
      margin-left: 0;
    }
  }
</style>

<script>
  let kind = "all";
  const only = document.getElementById("onlyRes") as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>(".talk")];
  const years = [...document.querySelectorAll<HTMLElement>(".year")];

  function apply() {
    for (const it of items) {
      it.hidden = !((kind === "all" || it.dataset.kind === kind) && (!only.checked || it.dataset.hasResources === "1"));
    }
    for (const y of years) {
      const visible = y.querySelectorAll(".talk:not([hidden])").length;
      y.hidden = visible === 0;
      y.classList.add("is-in");
      y.querySelector("small")!.textContent = String(visible);
    }
  }

  document.querySelectorAll<HTMLButtonElement>("button[data-kind]").forEach((b) =>
    b.addEventListener("click", () => {
      kind = b.dataset.kind!;
      document.querySelectorAll("button[data-kind]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      apply();
    }),
  );
  only.addEventListener("change", apply);
</script>
