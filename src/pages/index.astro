---
import Layout from "../layouts/Layout.astro";
import Portrait from "../components/Portrait.astro";
import About from "../components/About.astro";
import Stack from "../components/Stack.astro";
import Talks from "../components/Talks.astro";
import Projects from "../components/Projects.astro";
import PostCard from "../components/PostCard.astro";
import Icon from "../components/Icon.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
const latest = posts.slice(0, 6);
const roles = ["interfaces web", "componentes en Angular", "APIs y backends en Node.js", "apps con agentes de IA", "artículos técnicos", "ilustraciones", "comunidad"];
---

<Layout>
  <section class="hero">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__hello"><span class="wave-hand" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 11V5.5a1.5 1.5 0 0 1 3 0V10m0-.5V4a1.5 1.5 0 0 1 3 0v6m0-5a1.5 1.5 0 0 1 3 0v6m0-3.5a1.5 1.5 0 0 1 3 0V15a7 7 0 0 1-7 7h-1.2a6 6 0 0 1-4.6-2.2L3.4 16a1.6 1.6 0 0 1 2.4-2.1L7 15" /></svg></span> Hola, soy</p>
        <h1 class="hero__name">
          <span class="line"><span>Vanessa</span></span>
          <span class="line"><span><em class="serif">Marely</em> Aristizábal</span></span>
          <span class="line"><span>Ángel</span></span>
        </h1>
        <p class="hero__lede">
          Fullstack developer con foco en frontend, desde Medellín. <strong>Google Developer Expert</strong> en Angular y Web,
          <strong>GitHub Star</strong>, escritora, mentora, speaker e ilustradora.
        </p>
        <p class="hero__typing" aria-label={`Creo ${roles.join(", ")}`}>
          <span class="mono">creo</span>
          <span class="typed" id="typed" data-words={JSON.stringify(roles)} aria-hidden="true">{roles[0]}</span><span
            class="caret"
            aria-hidden="true"></span>
        </p>
        <div class="hero__ctas">
          <a class="btn btn--solid" href="#escritos">Leer mis artículos <Icon name="arrow" /></a>
          <a class="btn" href="/charlas/">Ver mis charlas</a>
        </div>
      </div>
      <Portrait />
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          [0, 1].map(() => (
            <span>
              Angular <i>✦</i> Web Platform <i>✦</i> React <i>✦</i> TypeScript <i>✦</i> Accesibilidad <i>✦</i> Ilustración <i>✦</i>
              Comunidad <i>✦</i> Mentoría <i>✦</i>{" "}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <About postCount={posts.length} />
  <Stack />
  <Talks />
  <Projects />

  <section class="section" id="escritos">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Escritos</span>
          <h2 class="section-title">Lo último que <em class="serif">he escrito</em></h2>
        </div>
        <a class="btn" href="/blog/">Ver todos ({posts.length}) <Icon name="arrow" /></a>
      </div>
      {
        latest.length > 0 ? (
          <div class="posts">
            {latest.map((post, i) => (
              <PostCard post={post} index={i} />
            ))}
          </div>
        ) : (
          <p class="muted">
            Encuentra mis artículos en <a href="https://dev.to/vanessamarely">DEV</a> y{" "}
            <a href="https://medium.com/@vanessamarely">Medium</a>.
          </p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: blur(70px);
    opacity: 0.55;
  }
  .aurora span {
    position: absolute;
    border-radius: 50%;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .aurora span:nth-child(1) {
    width: 40vw;
    height: 40vw;
    background: var(--violet);
    top: -10%;
    left: -10%;
    opacity: 0.45;
  }
  .aurora span:nth-child(2) {
    width: 32vw;
    height: 32vw;
    background: var(--coral);
    bottom: 0;
    right: 5%;
    opacity: 0.35;
    animation-delay: -6s;
  }
  .aurora span:nth-child(3) {
    width: 26vw;
    height: 26vw;
    background: var(--sun);
    top: 30%;
    left: 40%;
    opacity: 0.3;
    animation-delay: -12s;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
  }

  .hero__hello {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 1rem var(--font-mono);
    color: var(--muted);
    animation: rise 0.9s var(--ease) both;
  }

  .wave-hand svg {
    width: 26px;
    fill: none;
    stroke: var(--coral);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-origin: 70% 90%;
    animation: hand 2.4s ease-in-out 1s infinite;
  }

  .hero__name {
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin: 18px 0 26px;
  }
  .hero__name .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__name .line > span {
    display: inline-block;
    animation: rise 1.1s var(--ease) both;
  }
  .hero__name .line:nth-child(3) > span {
    animation-delay: 0.24s;
  }
  .hero__name .line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .hero__name em {
    color: var(--violet);
    font-size: 1.08em;
  }

  .hero__lede {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    max-width: 34ch;
    color: var(--muted);
    animation: rise 1.1s var(--ease) 0.25s both;
  }
  .hero__lede strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero__typing {
    margin: 22px 0 32px;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: rise 1.1s var(--ease) 0.35s both;
  }
  .mono {
    font-family: var(--font-mono);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .typed {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--coral);
  }
  .caret {
    width: 2px;
    height: 1.4em;
    background: var(--ink);
    animation: caret 1s steps(1) infinite;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: rise 1.1s var(--ease) 0.45s both;
  }

  .marquee {
    margin-top: clamp(40px, 7vw, 80px);
    border-block: 1.5px solid var(--ink);
    padding: 14px 0;
    overflow: hidden;
    rotate: -1.2deg;
    background: var(--sun);
    color: #1d1727;
    width: 104%;
    margin-left: -2%;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .marquee__track span {
    padding-right: 0.6em;
  }
  .marquee i {
    font-style: normal;
    color: var(--coral);
    margin: 0 0.4em;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  .muted {
    color: var(--muted);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }
  @keyframes drift {
    to {
      transform: translate(8vw, 6vh) scale(1.15);
    }
  }
  @keyframes hand {
    0%,
    60%,
    100% {
      rotate: 0deg;
    }
    10%,
    30% {
      rotate: 16deg;
    }
    20%,
    40% {
      rotate: -8deg;
    }
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 100px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero :global(.portrait) {
      order: -1;
      width: min(78%, 360px);
    }
  }
</style>

<script>
  // Typewriter for the rotating role
  const el = document.getElementById("typed");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (el && !reduce) {
    const words: string[] = JSON.parse(el.dataset.words!);
    let w = 0;
    let i = words[0].length;
    let deleting = true;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    (async function loop() {
      await sleep(2200);
      while (true) {
        const word = words[w];
        if (deleting) {
          i--;
          if (i === 0) {
            deleting = false;
            w = (w + 1) % words.length;
          }
        } else {
          i++;
          if (i === words[w].length) {
            deleting = true;
            el.textContent = words[w];
            await sleep(2000);
            continue;
          }
        }
        el.textContent = (deleting ? word : words[w]).slice(0, i);
        await sleep(deleting ? 35 : 70);
      }
    })();
  }
</script>
