---
import Icon from "./Icon.astro";
import { sourceLabel, type Post } from "../lib/posts";

interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;

const date = new Intl.DateTimeFormat("es-CO", { day: "numeric", month: "short", year: "numeric" }).format(
  new Date(post.date),
);
// Deterministic pattern for posts without a cover image
const hue = [...post.title].reduce((a, c) => a + c.charCodeAt(0), 0) % 4;
const searchText = `${post.title} ${post.tags.join(" ")}`.toLowerCase();
---

<article
  class="post reveal"
  style={`--i:${index % 3}`}
  data-source={post.source}
  data-also={post.alsoOn?.source}
  data-lang={post.lang}
  data-search={searchText}
>
  <a class="post__link" href={post.url} target="_blank" rel="noopener">
    <div class="post__media">
      {
        post.cover ? (
          <img src={post.cover} alt="" loading="lazy" decoding="async" width="600" height="315" />
        ) : (
          <svg class={`post__pattern p${hue}`} viewBox="0 0 600 315" aria-hidden="true">
            <rect width="600" height="315" />
            <circle cx="470" cy="80" r="90" />
            <path d="M0 260 Q 150 160 300 240 T 600 220 V315 H0 Z" />
            <text x="40" y="90">{"</>"}</text>
          </svg>
        )
      }
      <span class={`post__source post__source--${post.source}`}>
        <Icon name={post.source} size={16} />
        {sourceLabel[post.source]}
      </span>
    </div>
    <div class="post__body">
      <div class="post__meta">
        <time datetime={post.date}>{date}</time>
        {post.readingMinutes && <span>· {post.readingMinutes} min</span>}
        <span class="post__lang">{post.lang.toUpperCase()}</span>
      </div>
      <h3>{post.title}</h3>
      <p>{post.excerpt}</p>
      <span class="post__more">
        Leer artículo <Icon name="arrow" size={18} />
      </span>
    </div>
  </a>
  {
    post.alsoOn && (
      <a class="post__also" href={post.alsoOn.url} target="_blank" rel="noopener">
        También en {sourceLabel[post.alsoOn.source]}
      </a>
    )
  }
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), opacity 0.9s var(--ease);
  }
  .post.is-in:hover {
    transform: translateY(-6px) rotate(-0.4deg);
    box-shadow: 8px 8px 0 var(--violet);
  }
  .post[hidden] {
    display: none;
  }

  .post__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
  }

  .post__media {
    position: relative;
    aspect-ratio: 1.9;
    overflow: hidden;
    background: var(--bg-2);
  }
  .post__media img,
  .post__pattern {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .post:hover .post__media img,
  .post:hover .post__pattern {
    transform: scale(1.05);
  }

  .post__pattern rect {
    fill: var(--c1);
  }
  .post__pattern circle {
    fill: var(--c2);
  }
  .post__pattern path {
    fill: var(--c3);
  }
  .post__pattern text {
    font: 700 64px var(--font-mono);
    fill: #1d1727;
  }
  .p0 {
    --c1: var(--violet);
    --c2: var(--sun);
    --c3: var(--coral);
  }
  .p1 {
    --c1: var(--mint);
    --c2: var(--surface);
    --c3: var(--violet);
  }
  .p2 {
    --c1: var(--coral);
    --c2: var(--sun);
    --c3: var(--mint);
  }
  .p3 {
    --c1: var(--sun);
    --c2: var(--coral);
    --c3: var(--violet);
  }

  .post__source {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    font: 600 0.75rem var(--font-mono);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 26px;
    flex: 1;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font: 500 0.8rem var(--font-mono);
    color: var(--muted);
  }
  .post__lang {
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1px 6px;
  }

  .post h3 {
    font-size: 1.3rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .post p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .post__more {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .post__more :global(svg) {
    transition: transform 0.35s var(--ease);
  }
  .post:hover .post__more :global(svg) {
    transform: translateX(6px);
  }

  .post__also {
    position: absolute;
    top: 14px;
    right: 14px;
    font: 500 0.72rem var(--font-mono);
    padding: 6px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 80%, transparent);
    color: var(--bg);
    text-decoration: none;
    backdrop-filter: blur(6px);
  }
  .post__also:hover {
    background: var(--ink);
  }
</style>
