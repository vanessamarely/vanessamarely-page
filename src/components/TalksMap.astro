---
// Travel map: cities where I gave in-person talks, filterable by year.
// Arcs start at home (Medellín); dot size grows with the number of talks in that city.
import { countries, project } from "../data/americas-map";
import { places, placeName, HOME, type PlaceKey } from "../data/places";
import { sortedTalks } from "../data/talks";
import TalkItem from "./TalkItem.astro";
import { langOf, useT } from "../i18n";

const lang = langOf(Astro.currentLocale);
const tr = useT(lang);
const name = (key: PlaceKey) => placeName(lang, key);
// Map country names (the map data is in Spanish)
const countryEn: Record<string, string> = {
  "Estados Unidos": "United States", "Islas Georgias del Sur y Sandwich del Sur": "South Georgia and the South Sandwich Islands",
  "Islas Malvinas": "Falkland Islands", "Trinidad y Tobago": "Trinidad and Tobago", Surinam: "Suriname", "Perú": "Peru",
  "Panamá": "Panama", "México": "Mexico", "Haití": "Haiti", Francia: "France", "República Dominicana": "Dominican Republic",
  Brasil: "Brazil", Belice: "Belize", "Antártida": "Antarctica",
};
const countryName = (n: string) => (lang === "en" ? (countryEn[n] ?? n) : n);

type Stop = { key: PlaceKey; counts: Record<string, number>; total: number; x: number; y: number };

const stops = new Map<PlaceKey, Stop>();
let online = 0;
const onlineByYear: Record<string, number> = {};
for (const t of sortedTalks) {
  const year = t.date.slice(0, 4);
  if (t.where === "online") {
    online++;
    onlineByYear[year] = (onlineByYear[year] ?? 0) + 1;
    continue;
  }
  if (!t.where) continue;
  const p = places[t.where];
  const stop = stops.get(t.where) ?? { key: t.where, counts: {}, total: 0, ...project(p.lat, p.lon) };
  stop.counts[year] = (stop.counts[year] ?? 0) + 1;
  stop.total++;
  stops.set(t.where, stop);
}

const list = [...stops.values()].sort((a, b) => b.total - a.total);
const years = [...new Set(list.flatMap((s) => Object.keys(s.counts)))].sort().reverse();
const home = project(places[HOME].lat, places[HOME].lon);
const radius = (n: number) => 3.5 + Math.sqrt(n) * 2.6;

// Curved arc from home to a stop, bending to the side
function arc(x: number, y: number) {
  const mx = (home.x + x) / 2;
  const my = (home.y + y) / 2;
  const dx = x - home.x;
  const dy = y - home.y;
  const bend = 0.25;
  return `M${home.x.toFixed(1)} ${home.y.toFixed(1)} Q${(mx - dy * bend).toFixed(1)} ${(my + dx * bend).toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
}

const visitedCountries = (year: string) =>
  [...new Set(list.filter((s) => year === "all" || s.counts[year]).map((s) => places[s.key].code))];
const countryYears = new Map<string, string[]>();
for (const s of list) {
  const code = places[s.key].code;
  countryYears.set(code, [...new Set([...(countryYears.get(code) ?? []), ...Object.keys(s.counts)])]);
}

// Cities grouped by country (most talks first) for the list next to the map
const groups = [...list.reduce((m, s) => {
  const code = places[s.key].code;
  const g = m.get(code) ?? { code, country: name(s.key).country, total: 0, cities: [] as Stop[] };
  g.total += s.total;
  g.cities.push(s);
  return m.set(code, g);
}, new Map<string, { code: string; country: string; total: number; cities: Stop[] }>()).values()].sort((a, b) => b.total - a.total);

// In-person talks, newest first, for the list under the map (filtered by city/country and year)
const inPerson = sortedTalks.filter((t) => t.where && t.where !== "online") as (typeof sortedTalks[number] & { where: PlaceKey })[];

const payload = {
  stops: Object.fromEntries(list.map((s) => [s.key, s.counts])),
  online: onlineByYear,
  onlineTotal: online,
};
---

<div class="tmap" id="talksMap">
  <div class="tmap__map">
    <svg viewBox="40 0 450 500" role="img" aria-labelledby="tmap-title">
      <title id="tmap-title">{tr("map.title")}</title>
      <defs>
        <pattern id="tmap-dots" width="6" height="6" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="0.8" class="tmap__grid" />
        </pattern>
      </defs>
      <rect x="40" y="0" width="450" height="500" fill="url(#tmap-dots)" />
      <g class="tmap__countries">
        {
          countries.map((c) => (
            <path
              d={c.d}
              data-code={c.code}
              data-name={countryName(c.name)}
              data-years={(countryYears.get(c.code) ?? []).join(" ")}
              class={countryYears.has(c.code) ? "is-visited" : undefined}
            >
              <title>{countryName(c.name)}</title>
            </path>
          ))
        }
      </g>
      <g class="tmap__arcs">
        {
          list
            .filter((s) => s.key !== HOME)
            .map((s) => <path d={arc(s.x, s.y)} pathLength="1" data-key={s.key} data-years={Object.keys(s.counts).join(" ")} />)
        }
      </g>
      <g class="tmap__stops">
        {
          list.map((s) => (
            <g
              class="stop"
              data-key={s.key}
              data-years={Object.keys(s.counts).join(" ")}
              transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)})`}
              tabindex="0"
              role="button"
              aria-label={`${name(s.key).city}, ${name(s.key).country}`}
            >
              <circle class="stop__pulse" r={radius(s.total)} />
              <circle class="stop__dot" r={radius(s.total)} />
              <text class="stop__label" x={radius(s.total) + 4} y="4">
                {name(s.key).city}
              </text>
              <title>{`${name(s.key).city}, ${name(s.key).country}: ${s.total} ${s.total === 1 ? tr("map.talk") : tr("map.talks")}`}</title>
            </g>
          ))
        }
      </g>
      <g class="tmap__home" transform={`translate(${home.x.toFixed(1)} ${home.y.toFixed(1)})`}>
        <path d="M0 -9 L2.6 -2.8 9 -2.8 3.8 1.2 5.8 7.6 0 3.8 -5.8 7.6 -3.8 1.2 -9 -2.8 -2.6 -2.8 Z" />
      </g>
    </svg>
  </div>

  <aside class="tmap__panel">
    <div class="tmap__years" role="group" aria-label={tr("map.byYear")}>
      <button type="button" data-year="all" aria-pressed="true">{tr("map.all")}</button>
      {years.map((y) => <button type="button" data-year={y} aria-pressed="false">{y}</button>)}
    </div>

    <p class="tmap__summary" aria-live="polite">
      <Fragment
        set:html={tr("map.summary.html")
          .replace("{talks}", String(list.reduce((n, s) => n + s.total, 0)))
          .replace("{cities}", String(list.length))
          .replace("{countries}", String(visitedCountries("all").length))}
      />
      <span class="tmap__online">+ <span data-summary="online">{online}</span> {tr("map.online")}</span>
    </p>

    <ul class="tmap__list">
      {
        groups.map((g) => (
          <li class="tmap__country" data-code={g.code}>
            <button type="button" class="tmap__pick tmap__pick--country" data-code={g.code} data-country={g.country} aria-pressed="false">
              {g.country}
              <span class="tmap__count" data-count>{g.total}</span>
            </button>
            <ul class="tmap__cities">
              {g.cities.map((c) => (
                <li data-key={c.key}>
                  <button
                    type="button"
                    class="tmap__pick tmap__pick--city"
                    data-key={c.key}
                    data-city={name(c.key).city}
                    data-country={g.country}
                    data-code={g.code}
                    aria-pressed="false"
                  >
                    {name(c.key).city}
                    <span class="tmap__count" data-count>{c.total}</span>
                  </button>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="tmap__hint">{tr("map.hint")}</p>
    <p class="tmap__legend">
      <svg viewBox="-10 -10 20 20" aria-hidden="true"><path d="M0 -9 L2.6 -2.8 9 -2.8 3.8 1.2 5.8 7.6 0 3.8 -5.8 7.6 -3.8 1.2 -9 -2.8 -2.6 -2.8 Z" /></svg>
      {tr("map.legend")}
    </p>
  </aside>
  <!-- Talks of the selected city or country -->
  <section class="tmap__results" hidden aria-live="polite" data-one={tr("map.talk")} data-many={tr("map.talks")}>
    <header class="tmap__results-head">
      <h4 data-results-title></h4>
      <div class="tmap__results-actions">
        <button type="button" class="tmap__chip" data-see-country hidden data-template={tr("map.seeCountry")}></button>
        <button type="button" class="tmap__chip" data-clear>{tr("map.clear")} ✕</button>
      </div>
    </header>
    <ul class="tmap__talks">
      {
        inPerson.map((t) => (
          <TalkItem talk={t} attrs={{ "data-place": t.where, "data-code": places[t.where].code, "data-year": t.date.slice(0, 4) }} />
        ))
      }
    </ul>
  </section>
  <script type="application/json" id="talksMapData" set:html={JSON.stringify(payload)} />
</div>

<style>
  .tmap {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 24px;
    padding: clamp(16px, 2.5vw, 28px);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .tmap__map svg {
    width: 100%;
    height: auto;
    max-height: 560px;
  }

  .tmap__grid {
    fill: var(--line);
  }

  .tmap__countries path {
    fill: color-mix(in srgb, var(--ink) 7%, var(--surface));
    stroke: var(--surface);
    stroke-width: 0.8;
    stroke-linejoin: round;
    transition: fill 0.4s;
  }
  .tmap__countries path.is-visited {
    fill: color-mix(in srgb, var(--violet) 22%, var(--surface));
  }
  .tmap__countries path.is-dim {
    fill: color-mix(in srgb, var(--ink) 7%, var(--surface));
  }

  .tmap__arcs path {
    fill: none;
    stroke: var(--coral);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.85;
  }
  .tmap.is-drawn .tmap__arcs path:not(.is-hidden) {
    animation: arc-draw 1.4s var(--ease) forwards;
    animation-delay: calc(var(--n, 0) * 70ms);
  }
  .tmap__arcs path.is-hidden {
    opacity: 0;
  }

  .stop {
    transition: opacity 0.4s;
  }
  .stop.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .stop__dot {
    fill: var(--coral);
    stroke: var(--surface);
    stroke-width: 1.6;
    transition: r 0.4s var(--ease);
  }
  .stop__pulse {
    fill: var(--coral);
    opacity: 0.35;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse-dot 2.4s ease-out infinite;
  }
  .stop__label {
    font: 600 10px var(--font-sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 3px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .stop:hover .stop__label,
  .stop.is-focus .stop__label {
    opacity: 1;
  }

  .tmap__home path,
  .tmap__legend path {
    fill: var(--sun);
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .tmap__panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .tmap__years {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tmap__years button {
    font: 500 0.85rem var(--font-mono);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .tmap__years button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .tmap__summary {
    font-size: 1.15rem;
    line-height: 1.45;
  }
  .tmap__summary strong {
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }
  .tmap__online {
    display: block;
    font: 500 0.85rem var(--font-mono);
    color: var(--muted);
  }

  /* Cities grouped by country, each with a count bubble */
  .tmap__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr));
    align-items: start;
    gap: 10px;
  }
  .tmap__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tmap__country {
    padding: 8px;
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .tmap__country[hidden],
  .tmap__cities li[hidden] {
    display: none;
  }
  .tmap__cities {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }
  .tmap__pick {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .tmap__pick--country {
    width: 100%;
    justify-content: space-between;
    padding: 4px 6px;
    font: 700 0.92rem var(--font-sans);
  }
  .tmap__pick--city {
    padding: 4px 4px 4px 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    font: 500 0.82rem var(--font-sans);
  }
  .tmap__pick:hover,
  .tmap__cities li.is-focus .tmap__pick {
    color: var(--coral);
  }
  .tmap__pick[aria-pressed="true"] {
    background: var(--coral);
    border-color: var(--coral);
    color: #1d1727;
  }
  /* the bubble */
  .tmap__count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--coral) 18%, var(--surface));
    color: var(--ink);
    font: 600 0.72rem var(--font-mono);
  }
  .tmap__pick[aria-pressed="true"] .tmap__count {
    background: var(--surface);
  }

  .tmap__legend {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    font: 400 0.75rem var(--font-mono);
    color: var(--muted);
  }
  .tmap__legend svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  @keyframes arc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pulse-dot {
    from {
      transform: scale(1);
      opacity: 0.4;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* Clickable map: dots and visited countries */
  .stop,
  .tmap__countries path.is-visited {
    cursor: pointer;
  }
  .stop:focus-visible {
    outline: none;
  }
  .stop:focus-visible .stop__dot,
  .stop.is-selected .stop__dot {
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .tmap__countries path.is-selected {
    fill: color-mix(in srgb, var(--coral) 35%, var(--surface));
  }

  .tmap__hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Talks of the selected place, under the map */
  .tmap__results {
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .tmap__results[hidden] {
    display: none;
  }
  .tmap__results-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-bottom: 6px;
  }
  .tmap__results-head h4 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .tmap__results-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tmap__chip {
    min-height: 36px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font: 500 0.82rem var(--font-sans);
    cursor: pointer;
  }
  .tmap__chip:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .tmap__chip[hidden] {
    display: none;
  }
  .tmap__talks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 860px) {
    .tmap {
      grid-template-columns: 1fr;
    }
    .tmap__map svg {
      max-height: 440px;
    }
  }
</style>

<script>
  const root = document.getElementById("talksMap");
  if (root) {
    const data = JSON.parse(document.getElementById("talksMapData")!.textContent!) as {
      stops: Record<string, Record<string, number>>;
      online: Record<string, number>;
      onlineTotal: number;
    };
    const radius = (n: number) => 3.5 + Math.sqrt(n) * 2.6;
    const $ = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];
    const summary = (k: string) => root.querySelector(`[data-summary="${k}"]`)!;

    function show(year: string) {
      const count = (key: string) =>
        year === "all"
          ? Object.values(data.stops[key]).reduce((a, b) => a + b, 0)
          : (data.stops[key][year] ?? 0);

      let talks = 0;
      let cities = 0;
      $<SVGGElement>(".stop").forEach((g) => {
        const n = count(g.dataset.key!);
        g.classList.toggle("is-hidden", n === 0);
        if (n) {
          talks += n;
          cities++;
          g.querySelectorAll("circle").forEach((c) => c.setAttribute("r", String(radius(n))));
          g.querySelector("text")!.setAttribute("x", String(radius(n) + 4));
        }
      });
      let i = 0;
      $<SVGPathElement>(".tmap__arcs path").forEach((p) => {
        const on = count(p.dataset.key!) > 0;
        p.classList.toggle("is-hidden", !on);
        if (on) p.style.setProperty("--n", String(i++));
      });
      const visited = new Set<string>();
      $<SVGPathElement>(".tmap__countries path.is-visited").forEach((p) => {
        const on = year === "all" || p.dataset.years!.split(" ").includes(year);
        p.classList.toggle("is-dim", !on);
        if (on) visited.add(p.dataset.code!);
      });
      // City bubbles, then each country's total
      $<HTMLLIElement>(".tmap__country").forEach((group) => {
        let total = 0;
        group.querySelectorAll<HTMLLIElement>(".tmap__cities li").forEach((li) => {
          const n = count(li.dataset.key!);
          total += n;
          li.hidden = n === 0;
          li.querySelector("[data-count]")!.textContent = String(n);
        });
        group.hidden = total === 0;
        group.querySelector(".tmap__pick--country [data-count]")!.textContent = String(total);
      });

      summary("talks").textContent = String(talks);
      summary("cities").textContent = String(cities);
      summary("countries").textContent = String(visited.size);
      summary("online").textContent = String(year === "all" ? data.onlineTotal : (data.online[year] ?? 0));

      // restart arc drawing
      root!.classList.remove("is-drawn");
      void root!.getBoundingClientRect();
      root!.classList.add("is-drawn");
    }

    // ---------- Selected city or country: its talks show under the map ----------
    type Selection = { by: "place" | "code"; value: string; label: string; code: string; country: string } | null;
    let year = "all";
    let selection: Selection = null;
    const results = root.querySelector<HTMLElement>(".tmap__results")!;
    const resultsTitle = results.querySelector<HTMLElement>("[data-results-title]")!;
    const seeCountry = results.querySelector<HTMLButtonElement>("[data-see-country]")!;
    const talkItems = [...results.querySelectorAll<HTMLLIElement>(".talk")];

    function renderSelection(scroll = false) {
      $<HTMLButtonElement>(".tmap__pick--city").forEach((b) =>
        b.setAttribute("aria-pressed", String(selection?.by === "place" && b.dataset.key === selection.value)),
      );
      $<HTMLButtonElement>(".tmap__pick--country").forEach((b) =>
        b.setAttribute("aria-pressed", String(selection?.by === "code" && b.dataset.code === selection.value)),
      );
      $<SVGGElement>(".stop").forEach((g) =>
        g.classList.toggle("is-selected", selection?.by === "place" && g.dataset.key === selection.value),
      );
      $<SVGPathElement>(".tmap__countries path").forEach((p) =>
        p.classList.toggle("is-selected", selection?.by === "code" && p.dataset.code === selection.value),
      );
      if (!selection) {
        results.hidden = true;
        return;
      }
      let n = 0;
      for (const li of talkItems) {
        const match =
          (selection.by === "place" ? li.dataset.place : li.dataset.code) === selection.value &&
          (year === "all" || li.dataset.year === year);
        li.hidden = !match;
        if (match) n++;
      }
      // Nothing in this place for the chosen year: close the panel
      if (n === 0) {
        selection = null;
        renderSelection();
        return;
      }
      const word = n === 1 ? results.dataset.one : results.dataset.many;
      resultsTitle.textContent = `${selection.label} · ${n} ${word}${year === "all" ? "" : ` · ${year}`}`;
      seeCountry.hidden = selection.by !== "place";
      seeCountry.textContent = (seeCountry.dataset.template ?? "").replace("{country}", selection.country);
      results.hidden = false;
      if (scroll) results.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    const pickPlace = (key: string, scroll = true) => {
      const b = root.querySelector<HTMLButtonElement>(`.tmap__pick--city[data-key="${key}"]`);
      if (!b) return;
      const same = selection?.by === "place" && selection.value === key;
      selection = same
        ? null
        : { by: "place", value: key, label: `${b.dataset.city}, ${b.dataset.country}`, code: b.dataset.code!, country: b.dataset.country! };
      renderSelection(scroll);
    };
    const pickCountry = (code: string, country: string, scroll = true) => {
      const same = selection?.by === "code" && selection.value === code;
      selection = same ? null : { by: "code", value: code, label: country, code, country };
      renderSelection(scroll);
    };

    $<HTMLButtonElement>(".tmap__pick--city").forEach((b) => b.addEventListener("click", () => pickPlace(b.dataset.key!)));
    $<HTMLButtonElement>(".tmap__pick--country").forEach((b) =>
      b.addEventListener("click", () => pickCountry(b.dataset.code!, b.dataset.country!)),
    );
    $<SVGGElement>(".stop").forEach((g) => {
      g.addEventListener("click", () => pickPlace(g.dataset.key!));
      g.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          pickPlace(g.dataset.key!);
        }
      });
    });
    $<SVGPathElement>(".tmap__countries path.is-visited").forEach((p) =>
      p.addEventListener("click", () => pickCountry(p.dataset.code!, p.dataset.name!)),
    );
    seeCountry.addEventListener("click", () => selection && pickCountry(selection.code, selection.country));
    results.querySelector("[data-clear]")!.addEventListener("click", () => {
      selection = null;
      renderSelection();
    });

    $<HTMLButtonElement>("[data-year]").forEach((b) =>
      b.addEventListener("click", () => {
        $("[data-year]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        year = b.dataset.year!;
        show(year);
        renderSelection();
      }),
    );

    // Hovering a city in the list highlights it on the map (and vice versa)
    const focus = (key: string | undefined, on: boolean) => {
      if (!key) return;
      root.querySelectorAll(`[data-key="${key}"]`).forEach((el) => el.classList.toggle("is-focus", on));
    };
    $<HTMLElement>(".tmap__cities li, .stop").forEach((el) => {
      el.addEventListener("pointerenter", () => focus(el.dataset.key, true));
      el.addEventListener("pointerleave", () => focus(el.dataset.key, false));
    });

    new IntersectionObserver(
      ([e], obs) => {
        if (e.isIntersecting) {
          root.classList.add("is-drawn");
          obs.disconnect();
        }
      },
      { threshold: 0.3 },
    ).observe(root);
  }
</script>
