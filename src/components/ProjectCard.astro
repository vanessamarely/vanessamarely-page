---
import Icon from "./Icon.astro";
import { categoryLabel, localizeProject, type Project } from "../data/projects";
import { langOf, useT, dateLocale } from "../i18n";
import type { RepoStats } from "../lib/github";

interface Props {
  project: Project;
  stats?: RepoStats;
  index?: number;
}
const { project, stats, index = 0 } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = useT(lang);
const p = localizeProject(project, lang);
const repoUrl = `https://github.com/vanessamarely/${p.repo}`;
const updated = stats?.pushedAt
  ? new Intl.DateTimeFormat(dateLocale[lang], { month: "short", year: "numeric" }).format(new Date(stats.pushedAt))
  : null;
---

<article class={`proj proj--${p.category} reveal`} style={`--i:${index % 3}`} data-category={p.category}>
  <!-- Outer element is the stable hover target; only .proj__card lifts (avoids hover flicker at the edges) -->
  <div class="proj__card">
  <header>
    <span class="proj__cat">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {p.category === "open-source" && <path d="M12 3a9 9 0 0 0-3 17.5l2-5.2a3.5 3.5 0 1 1 2 0l2 5.2A9 9 0 0 0 12 3z" />}
        {p.category === "tool" && <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z" />}
        {p.category === "talk" && <path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" />}
      </svg>
      {categoryLabel[lang][p.category]}
    </span>
    {
      stats && (
        <span class="proj__stats" title={`${stats.stars} ${t("project.stars")} · ${stats.forks} forks`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8z" /></svg>
          {stats.stars}
          {stats.forks > 0 && (
            <>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v2a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V7M12 12v5" /></svg>
              {stats.forks}
            </>
          )}
        </span>
      )
    }
  </header>

  <h3><a href={repoUrl} target="_blank" rel="noopener" class="proj__title">{p.title}</a></h3>
  <p class="proj__desc">{p.description}</p>
  {p.talk && <p class="proj__talk">{t("project.usedIn")}: {p.talk}</p>}
  {updated && <p class="proj__updated">{t("project.updated")}: <time datetime={stats!.pushedAt}>{updated}</time></p>}

  <ul class="proj__tags">
    {p.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <footer>
    <a href={repoUrl} target="_blank" rel="noopener"><Icon name="github" size={16} /> {t("project.code")}</a>
    {p.demo && <a href={p.demo} target="_blank" rel="noopener">Demo <Icon name="arrow" size={16} /></a>}
    {p.docs && <a href={p.docs} target="_blank" rel="noopener">Slides <Icon name="arrow" size={16} /></a>}
  </footer>
  </div>
</article>

<style>
  .proj {
    display: flex;
    flex-direction: column;
  }
  .proj__card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transform: translateZ(0);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .proj[hidden] {
    display: none;
  }
  .proj.is-in:hover .proj__card {
    transform: translateY(-5px);
    box-shadow: 6px 6px 0 var(--accent);
  }
  .proj--open-source {
    --accent: var(--mint);
  }
  .proj--tool {
    --accent: var(--sun);
  }
  .proj--talk {
    --accent: var(--violet);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .proj__cat,
  .proj__stats {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 0.75rem var(--font-mono);
    color: var(--muted);
  }
  .proj__cat svg {
    width: 26px;
    height: 26px;
    padding: 5px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .proj__stats svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  .proj__stats svg:first-child {
    fill: var(--sun);
    stroke: var(--ink);
  }

  h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .proj__title {
    text-decoration: none;
  }
  .proj__title::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .proj__desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .proj__talk {
    font: 500 0.8rem var(--font-mono);
    color: var(--ink);
    padding-left: 10px;
    border-left: 3px solid var(--accent);
  }

  .proj__updated {
    font: 400 0.75rem var(--font-mono);
    color: var(--muted);
  }

  .proj__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .proj__tags li {
    font: 500 0.72rem var(--font-mono);
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--bg-2);
  }

  footer {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    gap: 8px;
  }
  footer a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  footer a:hover {
    background: var(--ink);
    color: var(--bg);
  }
</style>
