<script>
  // Places tabs: click / arrow keys; auto-advance while visible until the user interacts
  const places = document.getElementById("places");
  if (places) {
    const tabs = [...places.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!);
    let current = 0;
    let timer = 0;
    let touched = false;

    const select = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        const on = k === current;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[k].classList.toggle("is-active", on);
        panels[k].inert = !on;
      });
      if (focus) tabs[current].focus();
    };
    const stop = () => {
      touched = true;
      clearInterval(timer);
    };

    tabs.forEach((t, i) =>
      t.addEventListener("click", () => {
        stop();
        select(i);
      }),
    );
    places.querySelector('[role="tablist"]')!.addEventListener("keydown", (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== "ArrowRight" && key !== "ArrowLeft") return;
      stop();
      select(current + (key === "ArrowRight" ? 1 : -1), true);
    });
    places.addEventListener("pointerenter", () => clearInterval(timer));
    places.addEventListener("pointerleave", () => !touched && start());

    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => select(current + 1), 5000);
    };
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      new IntersectionObserver(([e]) => (e.isIntersecting && !touched ? start() : clearInterval(timer)), {
        threshold: 0.4,
      }).observe(places);
    }
  }
</script>
