---
interface Props {
  postCount: number;
}
const { postCount } = Astro.props;
---

<section class="section" id="sobre-mi">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Sobre mí</span>
        <h2 class="section-title">Código, comunidad <br /><em class="serif">y muchos lápices</em></h2>
      </div>
    </div>

    <div class="bento">
      <!-- Intro -->
      <article class="card card--intro reveal">
        <p class="lead">
          Soy una programadora <strong>curiosa</strong>, apasionada por la tecnología y enamorada de la Web. Soy fullstack
          con foco en frontend: construyo interfaces con <strong>Angular</strong> y <strong>React</strong>, y también
          los servicios y APIs que las sostienen con <strong>Node.js</strong>. Me encanta compartir lo que aprendo en
          artículos, charlas y mentorías.
        </p>
        <p class="muted">
          Me interesan el desarrollo web, el diseño, la ilustración y la animación. Cuando no estoy programando, estoy
          leyendo, viajando o volviendo a ver Harry Potter.
        </p>
        <dl class="stats">
          <div><dt>Repos públicos</dt><dd>190</dd></div>
          <div><dt>Artículos</dt><dd>{postCount}</dd></div>
          <div><dt>Base</dt><dd>MDE</dd></div>
        </dl>
      </article>

      <!-- Places: born in Fredonia, live in Envigado, work in Medellín -->
      <article class="card card--city reveal" style="--i:1" id="places">
        <div class="places__tabs" role="tablist" aria-label="Mis lugares">
          <button type="button" role="tab" id="tab-fredonia" aria-controls="place-fredonia" aria-selected="true">
            <small>Nací</small>Fredonia
          </button>
          <button type="button" role="tab" id="tab-envigado" aria-controls="place-envigado" aria-selected="false" tabindex="-1">
            <small>Vivo</small>Envigado
          </button>
          <button type="button" role="tab" id="tab-medellin" aria-controls="place-medellin" aria-selected="false" tabindex="-1">
            <small>Trabajo</small>Medellín
          </button>
        </div>

        <div class="places__stage">
          <!-- Fredonia -->
          <div class="place is-active" role="tabpanel" id="place-fredonia" aria-labelledby="tab-fredonia">
            <svg viewBox="0 0 300 170" class="city" aria-hidden="true">
              <circle class="city__sun" cx="58" cy="50" r="18" />
              <g class="fre__cloud">
                <ellipse cx="120" cy="40" rx="18" ry="7" /><ellipse cx="132" cy="34" rx="12" ry="8" />
              </g>
              <g class="fre__cloud fre__cloud--2">
                <ellipse cx="230" cy="58" rx="16" ry="6" /><ellipse cx="240" cy="53" rx="10" ry="7" />
              </g>
              <path class="city__m3" d="M0 124 C 30 108 60 108 92 122 L92 170 L0 170 Z M210 122 C 240 106 272 104 300 114 L300 170 L210 170 Z" />
              <!-- Cerro Bravo -->
              <path class="fre__combia" d="M40 152 C 88 134 116 74 140 40 C 148 29 158 29 166 40 C 188 74 214 130 264 152 Z" />
              <path class="fre__ridge" d="M153 34 C 150 70 140 104 118 136 M166 44 C 176 76 190 106 214 132" />
              <!-- church -->
              <g class="fre__church">
                <path d="M226 118 h30 v24 h-30 z" />
                <path d="M224 118 L241 106 L258 118 Z" class="roof" />
                <path d="M236 92 h10 v26 h-10 z" />
                <path d="M234 92 L241 80 L248 92 Z" class="roof" />
                <path d="M241 80 V72 M238 75 h6" class="cross" />
                <path d="M238 142 v-9 a3 3 0 0 1 6 0 v9" class="door" />
                <circle cx="241" cy="100" r="2.2" class="door" />
              </g>
              <!-- colorful Antioquian houses with wooden balconies -->
              <g class="fre__houses">
                <path d="M261 117 h21 v25 h-21 z" class="wall" />
                <path d="M258 118 L271.5 108 L285 118 Z" class="tile" />
                <path d="M261 126 h21 v3 h-21 z" class="balcony b1" />
                <path d="M264 126 v-4 M268 126 v-4 M272 126 v-4 M276 126 v-4 M280 126 v-4 M262 122 h19" class="rail" />
                <path d="M266 132 h5 v10 h-5 z" class="door d1" />
                <path d="M275 132 h4 v5 h-4 z" class="door d2" />
                <path d="M284 121 h14 v21 h-14 z" class="wall w2" />
                <path d="M282 122 L291 114.5 L300 122 Z" class="tile" />
                <path d="M284 129 h14 v3 h-14 z" class="balcony b2" />
                <path d="M287 129 v-4 M291 129 v-4 M295 129 v-4 M285 125 h12" class="rail" />
                <path d="M288.5 134 h5 v8 h-5 z" class="door d3" />
              </g>
              <!-- coffee hill -->
              <path class="fre__hill" d="M0 142 C 60 120 140 124 196 140 C 236 132 272 130 300 136 L300 170 L0 170 Z" />
              <path class="fre__row" d="M6 152 C 60 134 128 136 186 150" />
              <path class="fre__row" d="M0 162 C 70 146 150 148 214 160" />
              <path class="fre__row" d="M196 152 C 230 144 268 142 300 146" />
              <path class="fre__beans" d="M6 152 C 60 134 128 136 186 150" />
              <path class="fre__beans" d="M0 162 C 70 146 150 148 214 160" />
              <!-- plantain plant -->
              <g class="fre__plantain">
                <path d="M16 162 V128" class="stem" />
                <path d="M16 132 C 6 126 -2 116 2 108 C 8 114 12 122 16 132 Z" />
                <path d="M16 130 C 26 122 36 116 38 106 C 30 108 22 118 16 130 Z" />
                <path d="M16 140 C 4 138 -4 134 -6 128 C 4 128 10 132 16 140 Z" />
                <path d="M16 138 C 28 138 34 134 38 128 C 28 128 22 132 16 138 Z" />
              </g>
              <!-- chiva (escalera bus) driving over the coffee hills -->
              <g class="fre__chiva">
                <path d="M-15 -17 h30 v3 h-30 z" class="rack" />
                <circle cx="-9" cy="-19" r="2.2" class="bag" /><circle cx="-3" cy="-19.5" r="2.4" class="bag b2" /><circle cx="4" cy="-19" r="2.2" class="bag" /><circle cx="10" cy="-19" r="2" class="bag b2" />
                <path d="M-15 -14 h30 v11 h-30 z" class="body" />
                <path d="M-15 -10 h30" class="stripe s1" />
                <path d="M-15 -6.5 h30" class="stripe s2" />
                <path d="M-12 -13 h5 v3 h-5 z M-5 -13 h5 v3 h-5 z M2 -13 h5 v3 h-5 z M9 -13 h4 v3 h-4 z" class="win" />
                <circle cx="-8" cy="-2" r="3" class="wheel" /><circle cx="8" cy="-2" r="3" class="wheel" />
                <animateMotion dur="16s" repeatCount="indefinite" rotate="auto" path="M-30 150 C 40 126 120 120 196 140 C 236 132 272 130 330 137" />
              </g>
              <!-- birds -->
              <g class="fre__birds">
                <path d="M0 0 q4 -4 8 0 q4 -4 8 0 M14 8 q3 -3 6 0 q3 -3 6 0" />
                <animateMotion dur="14s" repeatCount="indefinite" path="M-30 70 C 60 40 160 60 330 30" />
              </g>
            </svg>
            <div class="card__label">
              <span class="chip">05.93° N, 75.67° O</span>
              <h3>Nací en Fredonia, Antioquia</h3>
              <p class="muted">Tierra cafetera del suroeste antioqueño, con el Cerro Bravo en el paisaje.</p>
            </div>
          </div>

          <!-- Envigado -->
          <div class="place" role="tabpanel" id="place-envigado" aria-labelledby="tab-envigado" inert>
            <svg viewBox="0 0 300 170" class="city" aria-hidden="true">
              <circle class="city__sun" cx="246" cy="44" r="18" />
              <!-- Loma del Escobero -->
              <path class="city__m3" d="M0 108 C 50 70 112 66 162 92 C 204 70 252 62 300 84 L300 170 L0 170 Z" />
              <!-- towers -->
              <g class="env__towers">
                <rect x="168" y="70" width="26" height="72" class="t1" />
                <rect x="198" y="84" width="22" height="58" class="t2" />
                <rect x="224" y="62" width="28" height="80" class="t3" />
                <rect x="256" y="90" width="22" height="52" class="t1" />
              </g>
              <g class="env__windows">
                <rect x="173" y="78" width="5" height="5" /><rect x="184" y="78" width="5" height="5" class="on" />
                <rect x="173" y="92" width="5" height="5" class="on o2" /><rect x="184" y="92" width="5" height="5" />
                <rect x="173" y="106" width="5" height="5" /><rect x="184" y="106" width="5" height="5" class="on o3" />
                <rect x="203" y="92" width="5" height="5" class="on o2" /><rect x="211" y="92" width="5" height="5" />
                <rect x="203" y="106" width="5" height="5" /><rect x="211" y="106" width="5" height="5" class="on" />
                <rect x="229" y="70" width="6" height="5" class="on o3" /><rect x="241" y="70" width="6" height="5" />
                <rect x="229" y="84" width="6" height="5" /><rect x="241" y="84" width="6" height="5" class="on o2" />
                <rect x="229" y="98" width="6" height="5" class="on" /><rect x="241" y="98" width="6" height="5" />
                <rect x="261" y="98" width="5" height="5" /><rect x="269" y="98" width="5" height="5" class="on o3" />
              </g>
              <!-- church and park -->
              <g class="fre__church">
                <path d="M58 116 h36 v26 h-36 z" />
                <path d="M56 116 L76 102 L96 116 Z" class="roof" />
                <path d="M70 84 h12 v32 h-12 z" />
                <path d="M68 84 L76 70 L84 84 Z" class="roof" />
                <path d="M76 70 V62 M73 65 h6" class="cross" />
                <circle cx="76" cy="94" r="3" class="door" />
                <path d="M72 142 v-10 a4 4 0 0 1 8 0 v10" class="door" />
              </g>
              <!-- Casa Museo Otraparte (Fernando González) -->
              <g class="env__otraparte">
                <path d="M103 119 h42 v23 h-42 z" class="wall" />
                <path d="M99 120 L124 105 L149 120 Z" class="tile" />
                <path d="M103 119 h42" class="eave" />
                <path d="M107 125 h8 v8 h-8 z M133 125 h8 v8 h-8 z" class="window" />
                <path d="M120 142 v-11 a4 4 0 0 1 8 0 v11" class="door" />
                <path d="M103 136 h14 M131 136 h14" class="trim" />
              </g>
              <g class="env__trees">
                <path d="M22 142 v-14 M157 142 v-12" />
                <circle cx="22" cy="122" r="10" /><circle cx="157" cy="124" r="9" />
              </g>
              <path class="city__m1" d="M0 142 H300 V170 H0 Z" />
              <!-- Quebrada La Ayurá crossing Envigado -->
              <path class="env__creek" d="M-5 160 C 30 150 60 166 100 156 C 140 147 170 165 210 157 C 245 150 270 162 305 155 L305 166 C 270 172 245 160 210 168 C 170 175 140 158 100 167 C 60 176 30 160 -5 170 Z" />
              <path class="env__ripples" d="M10 162 C 35 156 60 168 95 161 M130 159 C 160 154 185 168 220 162 M240 160 C 260 156 280 163 300 159" />
            </svg>
            <div class="card__label">
              <span class="chip">06.17° N, 75.59° O</span>
              <h3>Vivo en Envigado</h3>
              <p class="muted">Entre montañas y verde, a un paso de Medellín.</p>
            </div>
          </div>

          <!-- Medellín -->
          <div class="place" role="tabpanel" id="place-medellin" aria-labelledby="tab-medellin" inert>
        <svg viewBox="0 0 300 170" class="city" aria-hidden="true">
          <circle class="city__sun" cx="230" cy="60" r="22" />
          <path class="city__m3" d="M0 120 C 40 70 80 60 120 90 C 160 60 210 40 300 95 L300 170 L0 170 Z" />
          <path class="city__m2" d="M0 135 C 50 100 90 105 140 125 C 190 100 240 100 300 125 L300 170 L0 170 Z" />
          <g class="city__houses">
            <rect x="34" y="118" width="10" height="9" style="fill: var(--coral)" /><rect x="48" y="114" width="9" height="11" style="fill: var(--sun)" />
            <rect x="62" y="116" width="11" height="9" style="fill: var(--violet)" /><rect x="200" y="112" width="10" height="11" style="fill: var(--mint)" />
            <rect x="214" y="115" width="9" height="9" style="fill: var(--coral)" /><rect x="228" y="112" width="11" height="12" style="fill: var(--sun)" />
            <rect x="243" y="116" width="9" height="9" style="fill: var(--violet)" />
          </g>
          <!-- Biblioteca España (Santo Domingo): three dark rocks on the hill -->
          <g class="med__rocks">
            <path d="M246 121 L252 107 L263 110 L260 123 Z" />
            <path d="M260 123 L265 104 L277 108 L273 124 Z" />
            <path d="M273 124 L279 110 L289 114 L286 126 Z" />
          </g>
          <!-- skyline: Coltejer, EPM building and towers -->
          <g class="med__skyline">
            <rect x="110" y="98" width="15" height="44" class="b1" />
            <path d="M131 142 V74 L138.5 52 L146 74 V142 Z" class="coltejer" />
            <path d="M138.5 52 V40" class="spire" />
            <rect x="151" y="100" width="32" height="42" class="epm" />
            <path d="M151 110 h32 M151 120 h32 M151 130 h32 M159 100 v42 M167 100 v42 M175 100 v42" class="grid" />
            <rect x="187" y="110" width="13" height="32" class="b2" />
            <path d="M115 106 h5 M115 116 h5 M115 126 h5 M135 84 h7 M135 96 h7 M135 108 h7 M135 120 h7 M190 118 h7 M190 128 h7" class="lit" />
          </g>
          <path class="city__m1" d="M0 150 C 60 135 120 140 170 152 C 220 140 260 140 300 148 L300 170 L0 170 Z" />
          <!-- Metro de Medellín on its viaduct -->
          <path class="env__track" d="M0 156 H300 M40 156 V170 M120 156 V170 M200 156 V170 M280 156 V170" />
          <g class="env__train">
            <rect x="0" y="145" width="34" height="10" rx="3" />
            <rect x="36" y="145" width="34" height="10" rx="3" />
            <rect x="72" y="145" width="34" height="10" rx="3" />
            <path d="M5 148 h24 M41 148 h24 M77 148 h24" class="win" />
          </g>
          <!-- metrocable -->
          <path id="cable" class="city__cable" d="M-10 40 L 310 112" />
          <g class="city__car">
            <line x1="0" y1="-12" x2="0" y2="0" />
            <rect x="-9" y="0" width="18" height="14" rx="3" />
            <rect x="-6" y="3" width="12" height="5" rx="1" class="win" />
            <animateMotion dur="9s" repeatCount="indefinite" path="M-10 40 L 310 112" />
          </g>
        </svg>
            <div class="card__label">
              <span class="chip">06.25° N, 75.56° O</span>
              <h3>Trabajo en Medellín</h3>
              <p class="muted">Donde construyo software y comunidad tech.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- GDE -->
      <article class="card card--gde reveal" style="--i:2">
        <svg viewBox="0 0 120 120" class="badge" aria-hidden="true">
          <path class="badge__shield" pathLength="1" d="M60 10 L100 24 L94 78 C 90 92 74 104 60 110 C 46 104 30 92 26 78 L20 24 Z" />
          <path class="badge__code" pathLength="1" d="M48 50 L36 62 L48 74 M72 50 L84 62 L72 74 M64 46 L56 78" />
        </svg>
        <h3>Google Developer Expert</h3>
        <p class="muted">Angular &amp; Web Technologies</p>
      </article>

      <!-- GitHub Star -->
      <article class="card card--star reveal" style="--i:3">
        <svg viewBox="0 0 120 120" class="star" aria-hidden="true">
          <g class="star__rays">
            <path d="M60 4 v12 M60 104 v12 M4 60 h12 M104 60 h12 M20 20 l9 9 M91 91 l9 9 M100 20 l-9 9 M29 91 l-9 9" />
          </g>
          <path class="star__body" d="M60 22 L71 47 L98 49 L77 66 L84 93 L60 78 L36 93 L43 66 L22 49 L49 47 Z" />
          <circle class="star__eye" cx="53" cy="60" r="2.6" /><circle class="star__eye" cx="67" cy="60" r="2.6" />
          <path class="star__smile" d="M54 68 Q60 73 66 68" />
        </svg>
        <h3>GitHub Star</h3>
        <p class="muted">Open source y comunidad</p>
      </article>

      <!-- Interests -->
      <article class="card card--magic reveal" style="--i:4">
        <svg viewBox="0 0 220 140" class="magic" aria-hidden="true">
          <!-- books -->
          <g class="books">
            <rect x="20" y="104" width="86" height="16" rx="3" style="fill: var(--violet)" />
            <rect x="28" y="88" width="74" height="16" rx="3" style="fill: var(--coral)" />
            <rect x="16" y="72" width="80" height="16" rx="3" style="fill: var(--mint)" />
            <path d="M30 80 h40 M40 96 h36 M34 112 h50" />
          </g>
          <!-- glasses -->
          <g class="glasses">
            <circle cx="44" cy="54" r="11" /><circle cx="74" cy="54" r="11" /><path d="M55 54 h8 M33 52 l-8 -4 M85 52 l8 -4" />
          </g>
          <!-- wand -->
          <g class="wand">
            <path d="M130 120 L190 48" class="wand__stick" />
            <path d="M186 53 L194 44" class="wand__tip" />
          </g>
          <g class="sparks">
            <path d="M196 30 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3 Z" />
            <path d="M172 22 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2 Z" />
            <path d="M206 64 l2 4 4 2 -4 2 -2 4 -2 -4 -4 -2 4 -2 Z" />
          </g>
          <!-- lightning -->
          <path class="bolt" d="M150 14 L140 34 L150 34 L142 52" />
        </svg>
        <h3>Lectora, viajera y fan de Harry Potter</h3>
        <p class="muted">También hago journaling viajero: dibujos, boletos y notas de cada viaje.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(22px, 3vw, 32px);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .card h3 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .muted {
    color: var(--muted);
  }

  .card--intro {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card--city {
    grid-column: span 2;
    padding: 0;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, color-mix(in srgb, var(--sky) 55%, var(--surface)), var(--surface));
  }
  .card--gde,
  .card--star {
    grid-column: span 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .card--magic {
    grid-column: span 4;
  }

  .lead {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .lead strong {
    font-weight: 600;
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--sun) 70%, transparent) 62%);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: auto 0 0;
    padding-top: 12px;
  }
  .stats dt {
    font: 500 0.75rem var(--font-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stats dd {
    margin: 0;
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  /* city */
  .city {
    width: 100%;
    flex: 1;
  }
  .city__sun {
    fill: var(--sun);
    animation: bob 7s ease-in-out infinite;
  }
  .city__m3 {
    fill: color-mix(in srgb, var(--mint) 45%, var(--surface));
  }
  .city__m2 {
    fill: color-mix(in srgb, var(--mint) 70%, var(--ink));
    opacity: 0.85;
  }
  .city__m1 {
    fill: color-mix(in srgb, var(--mint) 40%, var(--ink));
  }
  .city__cable {
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.6;
  }
  .city__car line {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .city__car rect {
    fill: var(--coral);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .city__car .win {
    fill: var(--surface);
  }
  .card__label {
    padding: 0 24px 22px;
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .card__label p {
    font-size: 0.95rem;
    margin-top: -4px;
  }

  /* places tabs */
  .places__tabs {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 2;
    display: flex;
    gap: 4px;
    padding: 4px;
    width: fit-content;
    max-width: calc(100% - 28px);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
  }
  .places__tabs button {
    display: grid;
    line-height: 1.1;
    text-align: left;
    padding: 6px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 0.85rem var(--font-sans);
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .places__tabs small {
    font: 500 0.62rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.65;
  }
  .places__tabs [aria-selected="true"] {
    background: var(--ink);
    color: var(--bg);
  }
  .places__stage {
    display: grid;
    flex: 1;
  }
  .place {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateX(16px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease), visibility 0s 0.6s;
  }
  .place.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }

  /* Fredonia */
  .fre__combia {
    fill: color-mix(in srgb, var(--mint) 55%, var(--ink));
  }
  .fre__ridge {
    fill: none;
    stroke: var(--surface);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .fre__hill {
    fill: color-mix(in srgb, var(--mint) 42%, var(--ink));
  }
  .fre__row,
  .fre__beans {
    fill: none;
