---
// Orbit: the core technologies. Groups: full stack from the CV.
import { langOf, useT } from "../i18n";
const t = useT(langOf(Astro.currentLocale));
const inner = [
  { id: "react", label: "React" },
  { id: "angular", label: "Angular" },
  { id: "typescript", label: "TypeScript" },
  { id: "nodejs", label: "Node.js" },
];
const outer = [
  { id: "nextjs", label: "Next.js" },
  { id: "astro", label: "Astro" },
  { id: "tailwindcss", label: "Tailwind" },
  { id: "storybook", label: "Storybook" },
  { id: "graphql", label: "GraphQL" },
  { id: "express", label: "Express" },
  { id: "jest", label: "Jest" },
  { id: "playwright", label: "Playwright" },
  { id: "docker", label: "Docker" },
  { id: "vitejs", label: "Vite" },
];
const groups = [
  {
    name: "Frontend",
    items: ["React", "Next.js", "Angular", "Astro", "React Native", "TypeScript", "Storybook", "Styled Components", "Tailwind"],
  },
  { name: "Backend & APIs", items: ["Node.js", "Express", "NestJS", "GraphQL", "REST", "PHP", "Python", "Contentstack"] },
  { name: t("stack.testing"), items: ["Jest", "React Testing Library", "Playwright", "Axe DevTools", "Lighthouse", "WCAG 2.2"] },
  { name: t("stack.ai"), items: ["Claude Code", "GitHub Copilot", t("stack.agents"), "MCP", "Docker", "Git", "Webpack", "Vite"] },
];
---

<section class="section stack" id="stack">
  <div class="wrap stack__grid">
    <div class="stack__copy reveal">
      <span class="eyebrow">Stack</span>
      <h2 class="section-title" set:html={t("stack.title.html")} />
      <p class="muted">{t("stack.text")}</p>
      <div class="stack__groups">
        {
          groups.map((g) => (
            <div class="stack__group">
              <h3>{g.name}</h3>
              <ul class="stack__list" aria-label={g.name}>
                {g.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="orbit reveal" style="--i:1" aria-hidden="true">
      <svg class="orbit__rings" viewBox="0 0 500 500">
        <circle cx="250" cy="250" r="120" />
        <circle cx="250" cy="250" r="220" />
      </svg>
      <div class="orbit__core">
        <svg class="orbit__logo" viewBox="10 30 102 62">
          <path d="M16 44 L30 82 L44 48 C48 37 64 37 64 51 L64 82 L64 51 C64 37 82 37 82 51 L82 82" />
          <rect x="92" y="77" width="17" height="10" rx="4" />
        </svg>
      </div>
      <div class="ring ring--inner" style={`--n:${inner.length}`}>
        {
          inner.map((s, i) => (
            <div class="planet" style={`--k:${i}`} data-label={s.label}>
              <img src={`/icons/${s.id}.svg`} alt="" width="40" height="40" loading="lazy" />
            </div>
          ))
        }
      </div>
      <div class="ring ring--outer" style={`--n:${outer.length}`}>
        {
          outer.map((s, i) => (
            <div class="planet" style={`--k:${i}`} data-label={s.label}>
              <img src={`/icons/${s.id}.svg`} alt="" width="40" height="40" loading="lazy" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .stack {
    overflow: clip;
  }

  .stack__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: 48px;
  }

  .stack__copy p {
    margin: 20px 0 28px;
    max-width: 42ch;
    color: var(--muted);
  }

  .stack__groups {
    display: grid;
    gap: 18px;
  }
  .stack__group h3 {
    font: 500 0.75rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .stack__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack__list .chip {
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--surface);
    padding: 6px 12px;
  }

  .orbit {
    --size: min(100%, 500px);
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
    justify-self: center;
    container-type: inline-size;
  }

  .orbit__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .orbit__rings circle {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.2;
    stroke-width: 1.5;
    stroke-dasharray: 4 8;
  }

  .orbit__core {
    position: absolute;
    inset: 37%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font: 600 clamp(1rem, 4cqi, 1.6rem) var(--font-mono);
    box-shadow: 0 0 0 10px color-mix(in srgb, var(--violet) 25%, transparent), 0 0 0 22px color-mix(in srgb, var(--violet) 10%, transparent);
    animation: pulse 4s ease-in-out infinite;
  }

  /* Logo "Trazo" (brand/logo): stroke follows the core's text color, so it flips with the theme */
  .orbit__logo {
    width: 58%;
    height: auto;
    overflow: visible;
  }
  .orbit__logo path {
    fill: none;
    stroke: currentColor;
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .orbit__logo rect {
    fill: var(--coral);
    animation: orbit-blink 1.1s steps(1) infinite;
  }
  @keyframes orbit-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit__logo rect {
      animation: none;
    }
  }

  .ring {
    position: absolute;
    inset: 0;
    animation: spin var(--dur) linear infinite;
  }
  .ring--inner {
    --r: 24cqi;
    --dur: 30s;
  }
  .ring--outer {
    --r: 44cqi;
    --dur: 50s;
    animation-direction: reverse;
  }

  .planet {
    --angle: calc(360deg / var(--n) * var(--k));
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(46px, 13cqi, 64px);
    aspect-ratio: 1;
    margin: calc(clamp(46px, 13cqi, 64px) / -2);
    transform: rotate(var(--angle)) translate(var(--r)) rotate(calc(-1 * var(--angle)));
  }

  .planet img {
    width: 100%;
    height: 100%;
    padding: 22%;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    animation: spin var(--dur) linear infinite reverse;
    transition: scale 0.35s var(--ease);
  }
  .ring--outer .planet img {
    animation-direction: normal;
  }

  .planet::after {
    content: attr(data-label);
    position: absolute;
    left: 50%;
    top: 100%;
    translate: -50% 6px;
    font: 500 0.75rem var(--font-mono);
    background: var(--ink);
    color: var(--bg);
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .orbit:hover .ring,
  .orbit:hover .planet img {
    animation-play-state: paused;
  }
  .planet:hover img {
    scale: 1.2;
  }
  .planet:hover::after {
    opacity: 1;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 14px color-mix(in srgb, var(--violet) 22%, transparent), 0 0 0 30px color-mix(in srgb, var(--violet) 6%, transparent);
    }
  }

  @media (max-width: 860px) {
    .stack__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
